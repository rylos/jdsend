{
  "manifest_version": 3,
  "name": "jdsend",
  "version": "1.3.0",
  "description": "Send links to JDownloader from the browser, through My.JDownloader.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "jdsend",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "storage", "activeTab", "declarativeNetRequest"],
  "host_permissions": ["https://api.jdownloader.org/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/cnl-page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/cnl-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "cnl", "enabled": true, "path": "rules/cnl.json" }]
  },
  "web_accessible_resources": [{ "resources": ["cnl/jdcheck.js"], "matches": ["http://*/*", "https://*/*"] }],
  "commands": {
    "send-tab": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Send the current tab to JDownloader"
    }
  }
}
