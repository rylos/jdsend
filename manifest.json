{
  "manifest_version": 3,
  "name": "jdsend",
  "version": "1.4.4",
  "description": "Send links to JDownloader from the browser, through My.JDownloader.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "jdsend",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["https://api.jdownloader.org/*"],
  "commands": {
    "send-tab": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Send the current page to JDownloader"
    }
  }
}
